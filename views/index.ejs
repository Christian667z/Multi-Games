<!DOCTYPE html>
<html lang="fr" data-theme="red">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Multi-Games - Plateforme de Jeux PvP 4K</title>

    <link rel="stylesheet" href="assets/css/themes/themes.css">
    <link rel="stylesheet" href="assets/css/base.css">
    <style><%- customThemeCss %></style>

    <script src="assets/js/theme.js"></script>
    <script src="assets/js/audio.js" defer></script>
    <script src="dev/livereload.js" defer></script>

    <style>
        .hub-hero {
            text-align: center;
            padding: 3.5rem 1rem 2.5rem;
            position: relative;
        }
        .hub-tag {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 0.15em;
            color: var(--primary);
            text-transform: uppercase;
            background: var(--badge-bg);
            border: 1px solid var(--badge-border);
            padding: 0.35rem 0.9rem;
            border-radius: 9999px;
            margin-bottom: 1rem;
        }
        .hub-title {
            font-size: clamp(2.8rem, 5vw, 4.5rem);
            font-weight: 900;
            letter-spacing: -0.03em;
            color: #fff;
            margin-bottom: 0.8rem;
        }
        .hub-title span {
            color: var(--primary);
        }
        .hub-subtitle {
            font-size: clamp(1rem, 1.8vw, 1.25rem);
            color: var(--text-muted);
            max-width: 650px;
            margin: 0 auto;
            line-height: 1.5;
        }
        .hub-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(clamp(280px, 24vw, 460px), 1fr));
            gap: 1.8rem;
            margin-top: 1.5rem;
        }
        .game-card-link {
            text-decoration: none;
            color: inherit;
        }
        .game-badge {
            font-size: 0.72rem;
            font-weight: 700;
            padding: 0.25rem 0.65rem;
            border-radius: 9999px;
            letter-spacing: 0.04em;
        }
        .game-badge.active {
            background: rgba(16, 185, 129, 0.2);
            color: #34d399;
            border: 1px solid rgba(16, 185, 129, 0.4);
        }
        .game-badge.soon {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-dim);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .game-players {
            font-size: 0.78rem;
            color: var(--text-dim);
            font-family: 'JetBrains Mono', monospace;
        }
    </style>
</head>
<body>

    <!-- Barre supérieure -->
    <header class="topbar">
        <a href="index.php" class="brand-wrapper">
            <div class="brand-icon">
                <span class="x-sym">🎮</span>
            </div>
            <div class="brand-title">Multi-Games <span>PvP Hub</span></div>
        </a>

        <div class="topbar-actions">
            <a class="btn-topbar" href="space-core/">Parler à Space</a>
            <% if (user) { %>
                <a class="btn-topbar" href="account.php"><%= user.display_name %></a>
                <% if (user.role === 'admin') { %>
                    <a class="btn-topbar" href="admin.php">Administration</a>
                <% } %>
            <% } else { %>
                <a class="btn-topbar" href="account.php">Connexion / Inscription</a>
            <% } %>

            <!-- Bouton Palette -->
            <button class="btn-topbar palette-btn" id="theme-palette-btn" title="Changer de thème">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/><path d="M12 2a7 7 0 0 0 7 7c0 2-2 3-2 3"/>
                </svg>
            </button>

            <!-- Statistiques Persistantes -->
            <div class="level-badge" id="stats-pill" title="Vos victoires et défaites">
                <span>🏆</span>
                <span id="stats-pill-text">0 V | 0 D</span>
            </div>

            <!-- Paramètres Sélecteur Thème -->
            <select id="themeSelect" class="btn-topbar" style="background: rgba(255,255,255,0.06); outline: none; border-radius: 9999px;">
                <% gameThemes.forEach(function(theme) { %>
                    <option value="<%= theme.theme_key %>"><%= theme.name %></option>
                <% }); %>
            </select>
        </div>
    </header>

    <!-- Zone Principale -->
    <main class="main-container">
        <div class="hub-hero">
            <div class="hub-tag">⚡ Plateforme de Jeux Multijoueur</div>
            <h1 class="hub-title">MULTI-<span>GAMES</span></h1>
            <p class="hub-subtitle">
                Affrontez vos amis sur le même PC en Local, défiez-les sur le même réseau Wi-Fi ou mesurez-vous à nos IA.
            </p>
        </div>

        <div class="hub-grid">
            <% games.forEach(function(g) { %>
                <a class="game-card-link" href="<%= g.url %>">
                    <div class="mode-card" style="<%= !g.active ? 'opacity: 0.6; filter: grayscale(0.5); cursor: not-allowed;' : '' %>">
                        <div class="card-top">
                            <span class="game-players"><%= g.players %></span>
                            <span class="game-badge <%= g.active ? 'active' : 'soon' %>">
                                <%= g.badge %>
                            </span>
                        </div>

                        <div class="card-body">
                            <div class="card-illustration" style="font-size: 3rem;">
                                <%= g.icon %>
                            </div>

                            <h2 class="card-title"><%= g.name %></h2>
                            <p class="card-desc"><%= g.desc %></p>

                            <div class="card-actions">
                                <% if (g.active) { %>
                                    <button class="btn-primary-action">
                                        Jouer maintenant ➔
                                    </button>
                                <% } else { %>
                                    <button class="btn-secondary-action" disabled style="cursor: not-allowed; opacity: 0.7;">
                                        Arrive bientôt 🔒
                                    </button>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </a>
            <% }); %>
        </div>
    </main>

    <footer class="footer">
        © 2026 Space & Multi-Games. Tous droits réservés. Version 4.0
    </footer>

    <script>
        window.MG_CSRF = <%- JSON.stringify(csrfToken) %>;
        document.addEventListener('DOMContentLoaded', () => {
            const w = localStorage.getItem('mg_stat_wins') || '0';
            const l = localStorage.getItem('mg_stat_losses') || '0';
            const el = document.getElementById('stats-pill-text');
            if (el) el.textContent = `${w} V | ${l} D`;
        });
    </script>
    <script src="assets/js/account-presence.js" data-api="games/morpion/api.php" defer></script>

</body>
</html>
